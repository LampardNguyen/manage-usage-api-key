# API key OpenAI dùng chung (key thật) — proxy dùng key này để gọi OpenAI
OPENAI_API_KEY=sk-proj-xxxxxxxx

# Mật khẩu đăng nhập trang quản trị — đặt chuỗi dài, khó đoán
ADMIN_PASSWORD=doi-mat-khau-nay

# Cổng app lắng nghe (Apache reverse proxy trỏ về cổng này)
PORT=3005

# Đường dẫn gốc, phải khớp với cấu hình Apache
BASE_PATH=/openai-custom

# true khi chạy sau Apache có HTTPS (cookie Secure, lấy IP thật để chặn đoán mật khẩu)
BEHIND_HTTPS_PROXY=true

# Thời gian tối đa chờ OpenAI trả lời (giây)
UPSTREAM_TIMEOUT_SEC=120

# Số request tối đa / phút cho MỖI key con (0 = tắt, mặc định 60)
RATE_LIMIT_PER_MIN=60

# Nơi lưu dữ liệu (mặc định ./data/db.json)
# DATA_FILE=./data/db.json

# Chỉ dùng khi chạy thử với server giả lập: npm run mock
# OPENAI_BASE_URL=http://localhost:4010/v1
